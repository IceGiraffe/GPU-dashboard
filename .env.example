TOTAL_GPU_COUNT=64
DISPLAY_TIME_ZONE=Asia/Shanghai
#
# 可选：开启上报口令后，前端上报时需要填写“写入口令”
# WRITE_TOKEN=your-write-token
#
# 必填：开启删除功能前请配置管理员口令
# ADMIN_TOKEN=your-admin-token
#
# 推荐：部署到 Vercel 后接入 Postgres（Neon / Supabase / Prisma Postgres 等）
# POSTGRES_URL=postgres://...
# DATABASE_URL=postgres://...
#
# 兼容旧方案：也支持 Blob 持久化
# BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxx
